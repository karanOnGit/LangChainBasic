# ==============================================================================
# Conversational RAG Configuration
# ==============================================================================

# Required: Groq API Key for LLM Inference (Get it at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Default LLM Model Name
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Embedding Model (HuggingFace)
# Default zero-cost local model: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional: Default Vector Store
# Options: faiss, chroma, pinecone
DEFAULT_VECTOR_STORE=faiss

# Optional: ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Optional: FAISS Persistence Directory
FAISS_PERSIST_DIR=./data/faiss_index

# Optional: Pinecone Configuration (Only needed if using Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=langchain-rag-index
PINECONE_ENVIRONMENT=us-east-1

# RAG Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=4
LLM_TEMPERATURE=0.2
