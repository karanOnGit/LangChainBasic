# ==============================================================================
# Streamlit Community Cloud Secrets Configuration Template
# Paste these key-value pairs into Streamlit Cloud Dashboard > App Settings > Secrets
# ==============================================================================

# Required: Groq API Key for LLM Inference (Get from https://console.groq.com)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Optional: Default Groq Model
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional: Default Vector Store
# Options: faiss, chroma, pinecone
DEFAULT_VECTOR_STORE = "faiss"

# Optional: Embedding Model (HuggingFace)
EMBEDDING_MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"

# Optional: Pinecone Cloud Vector Store (Only needed if using Pinecone)
PINECONE_API_KEY = "your_pinecone_api_key_here"
PINECONE_INDEX_NAME = "langchain-rag-index"
PINECONE_ENVIRONMENT = "us-east-1"

# Hyperparameters
CHUNK_SIZE = "800"
CHUNK_OVERLAP = "150"
TOP_K_RETRIEVAL = "3"
LLM_TEMPERATURE = "0.2"
